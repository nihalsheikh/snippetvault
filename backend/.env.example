# Copy to `.env` and fill in. Every key below is read by config/env_config.py —
# the names must match exactly or the app crashes on import.

# Required. Postgres connection string.
DATABASE_URL=

# Required. Secret used to sign JWTs. Use a long random value.
JWT_SECRET_KEY=

# Required. Powers the AI explain endpoint.
GOOGLE_GEMINI_API_KEY=
# Must be a real Gemini model id, or every /api/ai/* call 502s with the
# provider's "model not found". Check https://ai.google.dev/gemini-api/docs/models
GOOGLE_GEMINI_MODEL="gemini-2.5-flash"

# Token lifetimes.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used for BOTH CORS origins and the email verification link.
# Must be the frontend's origin, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Base URL of this API, used to build absolute URLs in emails.
BACKEND_URL=http://127.0.0.1:8000

# Brevo transactional email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=